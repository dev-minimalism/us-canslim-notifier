# ========================================
# Telegram Bot Settings (Required)
# ========================================
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
CHAT_ID=YOUR_CHAT_ID_HERE

# ========================================
# Scan Settings
# ========================================
SCAN_INTERVAL=1800

# ========================================
# CAN SLIM Parameters
# ========================================
MARKET_INDEX_TICKER=SPY
MIN_QTR_EPS_GROWTH=25.0
MIN_ANNUAL_EPS_GROWTH=25.0
MIN_INST_OWNERSHIP_PCT=10.0
MIN_RS_VS_INDEX_PERF=10.0

# ========================================
# Pattern Detection Settings
# ========================================
VOLUME_SURGE_MIN=50
BREAKOUT_MAX=5
STOP_LOSS_PERCENT=-7.5

# ========================================
# Data Settings
# ========================================
ANALYSIS_PERIOD_DAYS=120
ANALYSIS_PERIOD=6mo

# ========================================
# SSH Tunnel Settings (for PostgreSQL)
# ========================================
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/id_rsa

# ========================================
# PostgreSQL Settings
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=us_canslim_notifier_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ========================================
# Backtest Settings
# ========================================
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_POSITION_SIZE_PCT=0.1
# BACKTEST_TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN

# Backtest Technical Parameters
BACKTEST_VOLUME_AVG_DAYS=50
BACKTEST_PIVOT_LOOKBACK_DAYS=20
BACKTEST_NEAR_52W_HIGH_PCT=0.10
BACKTEST_ABOVE_52W_LOW_PCT=1.50

# Backtest Risk Management
BACKTEST_STOP_LOSS_PCT=0.08
BACKTEST_TAKE_PROFIT_PCT=0.20
BACKTEST_HOLDING_DAYS_MAX=30
